#!/usr/bin/env bash
# heartbeat - CLI for managing filesystem-only local automations.
set -uo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REGISTRY="$HOME/.agents/heartbeat/registry.txt"
mkdir -p "$(dirname "$REGISTRY")"
touch "$REGISTRY"

usage() {
  cat <<'EOF'
Usage:
  heartbeat automations create
  heartbeat automations list
  heartbeat automations show [--project <path>]
  heartbeat automations edit
  heartbeat automations pause
  heartbeat automations resume
  heartbeat automations delete [--purge] [--project <path>]
  heartbeat runs list [--project <path>]
  heartbeat runs show <id>
  heartbeat runs annotate <id> "<note>"
EOF
}

automations_create() {
  # init.sh is the canonical implementation (scaffold, cron, AGENTS.md, registry).
  # This CLI is a thin wrapper so there is exactly one place that logic lives.
  "$SKILL_DIR/scripts/init.sh"
}

automations_list() {
  if [ ! -s "$REGISTRY" ]; then
    echo "No automations registered yet. Run: heartbeat automations create (inside a project)."
    return
  fi
  while IFS= read -r p; do
    [ -d "$p/automations/heartbeat" ] || continue
    local db="$p/automations/heartbeat/.heartbeat.db"
    local last="(no runs yet)"
    if [ -f "$db" ]; then
      last=$(sqlite3 "$db" "SELECT date || ' ' || time || ' - ' || status FROM runs ORDER BY ts DESC LIMIT 1;" 2>/dev/null)
      [ -z "$last" ] && last="(no runs yet)"
    fi
    printf "%-50s %s\n" "$p" "$last"
  done < "$REGISTRY"
}

automations_show() {
  local project="$(pwd)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local target="$project/automations/heartbeat"
  if [ ! -d "$target" ]; then
    echo "No automations/heartbeat/ at $project" >&2
    exit 1
  fi
  echo "Project: $project"
  if grep -qxF "$project" "$REGISTRY" 2>/dev/null; then
    echo "Registered: yes"
  else
    echo "Registered: no (not in $REGISTRY)"
  fi
  if crontab -l 2>/dev/null | grep -qF "$target"; then
    if crontab -l 2>/dev/null | grep -F "$target" | grep -q "^#"; then
      echo "Cron: paused"
    else
      echo "Cron: active"
    fi
  else
    echo "Cron: not scheduled"
  fi
  echo "---- HEARTBEAT.md ----"
  cat "$target/HEARTBEAT.md" 2>/dev/null || echo "(missing)"
  echo "---- last run ----"
  local db="$target/.heartbeat.db"
  if [ -f "$db" ]; then
    sqlite3 "$db" ".mode line
SELECT * FROM runs ORDER BY ts DESC LIMIT 1;"
  else
    echo "(no .heartbeat.db yet)"
  fi
}

automations_edit() {
  local target="./automations/heartbeat/HEARTBEAT.md"
  if [ ! -f "$target" ]; then
    echo "No automations/heartbeat/HEARTBEAT.md here. Run: heartbeat automations create (first)." >&2
    exit 1
  fi
  "${EDITOR:-vi}" "$target"
}

toggle_cron() {
  local mode="$1"
  local target="$(pwd)/automations/heartbeat"
  local tmp; tmp=$(mktemp)
  crontab -l 2>/dev/null > "$tmp" || true
  if [ "$mode" = pause ]; then
    sed -i.bak "\#$target# s/^\([^#]\)/#\1/" "$tmp"
  else
    sed -i.bak "\#$target# s/^#//" "$tmp"
  fi
  crontab "$tmp"
  rm -f "$tmp" "$tmp.bak"
  echo "heartbeat ${mode}d for $target"
}

automations_delete() {
  local project="$(pwd)"
  local purge=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --purge) purge=1; shift ;;
      *) shift ;;
    esac
  done
  local target="$project/automations/heartbeat"
  if [ ! -d "$target" ]; then
    echo "No automations/heartbeat/ at $project" >&2
    exit 1
  fi

  # Remove the cron entry.
  local tmp; tmp=$(mktemp)
  crontab -l 2>/dev/null | grep -vF "$target" > "$tmp" || true
  crontab "$tmp"
  rm -f "$tmp"

  # Unregister the project.
  local tmp2; tmp2=$(mktemp)
  grep -vxF "$project" "$REGISTRY" > "$tmp2" 2>/dev/null || true
  mv "$tmp2" "$REGISTRY"

  if [ "$purge" -eq 1 ]; then
    rm -rf "$target"
    echo "Deleted cron entry, registry entry, and $target (history is gone)."
  else
    echo "Deleted cron entry and registry entry. Files kept at $target (HEARTBEAT.md, RUNS.md, .heartbeat.db)."
    echo "Pass --purge to also delete those files."
  fi
}

runs_list() {
  local project="$(pwd)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local db="$project/automations/heartbeat/.heartbeat.db"
  if [ ! -f "$db" ]; then echo "No .heartbeat.db at $db" >&2; exit 1; fi
  sqlite3 "$db" ".mode markdown
.headers on
SELECT id, date, time, agent, status, duration_ms||'ms' AS duration, input_tokens||'/'||output_tokens AS tokens, printf('\$%.4f', cost_usd) AS cost, substr(output,1,60) AS summary FROM runs ORDER BY ts DESC LIMIT 20;"
}

runs_show() {
  local id="$1"
  local db="./automations/heartbeat/.heartbeat.db"
  if [ ! -f "$db" ]; then echo "No .heartbeat.db here" >&2; exit 1; fi
  sqlite3 "$db" ".mode line
SELECT * FROM runs WHERE id = $id;"
}

runs_annotate() {
  local id="$1"
  local note="$2"
  local db="./automations/heartbeat/.heartbeat.db"
  if [ ! -f "$db" ]; then echo "No .heartbeat.db here" >&2; exit 1; fi
  local note_json
  note_json=$(python3 -c "import json,sys;print(json.dumps(sys.argv[1]))" "$note")
  sqlite3 "$db" "UPDATE runs SET note = $note_json WHERE id = $id;"
  echo "annotated run $id"
}

cmd="${1:-}"
sub="${2:-}"
if [ $# -ge 2 ]; then shift 2; else shift $#; fi

case "$cmd" in
  automations)
    case "$sub" in
      create) automations_create ;;
      list) automations_list ;;
      show) automations_show "$@" ;;
      edit) automations_edit ;;
      pause) toggle_cron pause ;;
      resume) toggle_cron resume ;;
      delete) automations_delete "$@" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  runs)
    case "$sub" in
      list) runs_list "$@" ;;
      show) runs_show "$@" ;;
      annotate) runs_annotate "$@" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  *) usage; exit 1 ;;
esac
