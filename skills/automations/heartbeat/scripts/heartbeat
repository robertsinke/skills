#!/usr/bin/env bash
# heartbeat - CLI for local, scheduled project automations.
#
# Composition model: `init`, `register`, and `schedule enable/disable` are
# independent, testable primitives, each backed by its own canonical script.
# `automations create`/`delete` are thin convenience wrappers that compose
# them for the common case. See reference/CLI.md for the full command list.
set -uo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REGISTRY="$HOME/.agents/heartbeat/registry.txt"
mkdir -p "$(dirname "$REGISTRY")"
touch "$REGISTRY"

usage() {
  cat <<'EOF'
Usage:
  heartbeat init                                      # scaffold automations/ + _heartbeat/ (files only)
  heartbeat register                                   # add this project to the registry + AGENTS.md pointer
  heartbeat unregister                                 # remove this project from the registry
  heartbeat schedule enable                             # add this project's cron entry
  heartbeat schedule disable                            # remove/comment this project's cron entry

  heartbeat automations create                          # init + register + schedule enable
  heartbeat automations list                            # every registered project + its last run
  heartbeat automations show [--project <path>]          # registration, schedule, dashboard, last run
  heartbeat automations add <name>                       # create one automation from the template
  heartbeat automations edit <name>                      # edit and validate one automation
  heartbeat automations pause / resume                   # aliases for: schedule disable / schedule enable
  heartbeat automations delete [--purge] [--project <path>]  # schedule disable + unregister (add --purge to also delete files)

  heartbeat runs list [--project <path>]                 # recent runs as a markdown table
  heartbeat runs show <id>
  heartbeat runs annotate <id> "<note>"

  heartbeat capabilities refresh                         # rescan local agents, models, and effort
  heartbeat capabilities show                            # print _heartbeat/AGENT-OPTIONS.md

Full reference: reference/CLI.md (next to this skill's SKILL.md)
EOF
}

# ---- primitives: each backed by its own canonical script ----

cmd_init() { bash "$SKILL_DIR/scripts/init.sh"; }
cmd_register() { bash "$SKILL_DIR/scripts/register.sh"; }
cmd_unregister() { bash "$SKILL_DIR/scripts/unregister.sh" "$(pwd)"; }
cmd_schedule() {
  local mode="${1:-}"
  case "$mode" in
    enable|disable) bash "$SKILL_DIR/scripts/schedule.sh" "$mode" ;;
    *) echo "usage: heartbeat schedule <enable|disable>" >&2; exit 1 ;;
  esac
}

# ---- automations: composed wrappers over the primitives above ----

automations_create() {
  echo "== init =="; cmd_init
  echo "== register =="; cmd_register
  echo "== schedule enable =="; cmd_schedule enable
}

automations_list() {
  if [ ! -s "$REGISTRY" ]; then
    echo "No automations registered yet. Run: heartbeat automations create (inside a project)."
    return
  fi
  while IFS= read -r p; do
    [ -d "$p/automations/_heartbeat" ] || continue
    local db="$p/automations/_heartbeat/.heartbeat.db"
    local last="(no runs yet)"
    if [ -f "$db" ]; then
      last=$(sqlite3 "$db" "SELECT date || ' ' || time || ' - ' || status FROM runs ORDER BY ts DESC LIMIT 1;" 2>/dev/null)
      [ -z "$last" ] && last="(no runs yet)"
    fi
    printf "%-50s %s\n" "$p" "$last"
  done < "$REGISTRY"
}

automations_show() {
  local project
  project="$(pwd)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local automations="$project/automations"
  local runtime="$automations/_heartbeat"
  if [ ! -d "$runtime" ]; then
    echo "No automations/_heartbeat/ at $project" >&2
    exit 1
  fi
  echo "Project: $project"
  if grep -qxF "$project" "$REGISTRY" 2>/dev/null; then
    echo "Registered: yes"
  else
    echo "Registered: no (not in $REGISTRY - run: heartbeat register)"
  fi
  if crontab -l 2>/dev/null | grep -qF "$runtime"; then
    if crontab -l 2>/dev/null | grep -F "$runtime" | grep -q "^#"; then
      echo "Schedule: disabled"
    else
      echo "Schedule: enabled"
    fi
  else
    echo "Schedule: not scheduled (run: heartbeat schedule enable)"
  fi
  if [ -f "$runtime/.heartbeat.lock/pid" ]; then
    local lock_pid; lock_pid=$(cat "$runtime/.heartbeat.lock/pid" 2>/dev/null)
    if kill -0 "$lock_pid" 2>/dev/null; then
      echo "Lock: held (pid $lock_pid - a run is in progress)"
    else
      echo "Lock: stale (pid $lock_pid no longer running - next run will reclaim it)"
    fi
  fi
  echo "---- validation ----"
  python3 "$runtime/validate-heartbeat.py" "$automations" 2>&1 || true
  python3 "$runtime/heartbeat_engine.py" report "$automations"
  echo "---- INDEX.md ----"
  cat "$automations/INDEX.md" 2>/dev/null || echo "(missing)"
  echo "---- last run ----"
  local db="$runtime/.heartbeat.db"
  if [ -f "$db" ]; then
    sqlite3 "$db" ".mode line
SELECT * FROM runs ORDER BY ts DESC LIMIT 1;"
  else
    echo "(no .heartbeat.db yet)"
  fi
}

automations_add() {
  local name="${1:-}"
  [[ "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || { echo "name must be kebab-case" >&2; exit 1; }
  local target="./automations/tasks/$name.md"
  [ ! -e "$target" ] || { echo "$target already exists" >&2; exit 1; }
  cp "$SKILL_DIR/templates/AUTOMATION.md.template" "$target"
  local title; title=$(echo "$name" | tr '-' ' ')
  sed -i.bak "s/^title: .*/title: $title/; s/^name: .*/name: $name/" "$target" && rm -f "$target.bak"
  echo "created $target"
}

automations_edit() {
  local name="${1:-}"
  local target="./automations/tasks/$name.md"
  if [ ! -f "$target" ]; then
    echo "No automation named '$name'. Run: heartbeat automations add $name" >&2
    exit 1
  fi
  "${EDITOR:-vi}" "$target"
  python3 "./automations/_heartbeat/validate-heartbeat.py" "$target" || {
    echo "warning: automation is invalid and will not run until fixed" >&2
  }
}

automations_delete() {
  local project
  project="$(pwd)"
  local purge=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --purge) purge=1; shift ;;
      *) shift ;;
    esac
  done
  local automations="$project/automations"
  local runtime="$automations/_heartbeat"
  if [ ! -d "$runtime" ]; then
    echo "No automations/_heartbeat/ at $project" >&2
    exit 1
  fi
  ( cd "$project" && bash "$SKILL_DIR/scripts/schedule.sh" disable ) || true
  bash "$SKILL_DIR/scripts/unregister.sh" "$project"
  if [ "$purge" -eq 1 ]; then
    rm -rf "$runtime"
    rm -f "$automations/INDEX.md" "$automations/tasks/.ok/templates/automation.md" "$automations/tasks/.templates/automation.md"
    echo "Deleted cron entry, registry entry, heartbeat files, and $runtime (history is gone)."
    echo "Left $automations/tasks/.execution-reports/ in place - it's accumulated content, not runtime state. Delete it yourself if you want it gone too."
  else
    echo "Deleted cron entry and registry entry. Automation files and history remain in $automations."
    echo "Pass --purge to also delete those files."
  fi
}

runs_list() {
  local project
  project="$(pwd)"
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local db="$project/automations/_heartbeat/.heartbeat.db"
  if [ ! -f "$db" ]; then echo "No .heartbeat.db at $db" >&2; exit 1; fi
  sqlite3 "$db" ".mode markdown
.headers on
SELECT id, date, time, task, agent, model, effort, status, duration_ms||'ms' AS duration, COALESCE(NULLIF(substr(output,1,60), ''), report_path, '') AS summary FROM runs ORDER BY ts DESC LIMIT 20;"
}

capabilities() {
  case "${1:-show}" in
    refresh) python3 "./automations/_heartbeat/heartbeat_engine.py" scan "./automations" ;;
    show) cat "./automations/_heartbeat/AGENT-OPTIONS.md" ;;
    *) echo "usage: heartbeat capabilities <refresh|show>" >&2; exit 1 ;;
  esac
}

runs_show() {
  local id="$1"
  local db="./automations/_heartbeat/.heartbeat.db"
  if [ ! -f "$db" ]; then echo "No .heartbeat.db here" >&2; exit 1; fi
  sqlite3 "$db" ".mode line
SELECT * FROM runs WHERE id = $id;"
}

runs_annotate() {
  local id="$1"
  local note="$2"
  local db="./automations/_heartbeat/.heartbeat.db"
  if [ ! -f "$db" ]; then echo "No .heartbeat.db here" >&2; exit 1; fi
  local note_json
  note_json=$(python3 -c "import json,sys;print(json.dumps(sys.argv[1]))" "$note")
  sqlite3 "$db" "UPDATE runs SET note = $note_json WHERE id = $id;"
  echo "annotated run $id"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  init) cmd_init ;;
  register) cmd_register ;;
  unregister) cmd_unregister ;;
  schedule) cmd_schedule "$@" ;;
  automations)
    sub="${1:-}"; shift || true
    case "$sub" in
      create) automations_create ;;
      list) automations_list ;;
      show) automations_show "$@" ;;
      add) automations_add "$@" ;;
      edit) automations_edit "$@" ;;
      pause) cmd_schedule disable ;;
      resume) cmd_schedule enable ;;
      delete) automations_delete "$@" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  runs)
    sub="${1:-}"; shift || true
    case "$sub" in
      list) runs_list "$@" ;;
      show) runs_show "$@" ;;
      annotate) runs_annotate "$@" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  capabilities) capabilities "$@" ;;
  *) usage; exit 1 ;;
esac
